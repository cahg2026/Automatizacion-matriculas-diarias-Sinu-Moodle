# Plantilla de configuracion. Copiar a config/.env y rellenar.
# config/.env NUNCA se sube a Git (ver .gitignore).

# =====================================================================
# Power BI  (Etapa 1 - RPA con Playwright, no hay API para "Datos con
# diseno actual")
# =====================================================================
POWERBI_USUARIO=
POWERBI_PASSWORD=
# URL directa de la pagina MOODLE-VS-SINU-EST del informe ValidacionMoodle
POWERBI_URL_INFORME=
POWERBI_WORKSPACE=CUN Digital
POWERBI_INFORME=ValidacionMoodle
POWERBI_PAGINA=MOODLE-VS-SINU-EST

# Titulo del visual de TABLA que se exporta. NO es el nombre de la pagina
# (eso es POWERBI_PAGINA, que identifica el lienzo entero): solo los visuales
# de tabla/matriz permiten exportar "Datos con diseno actual".
# El localizador real es aria-roledescription="Tabla"; esto solo desempata
# cuando la pagina tiene mas de una tabla. Vacio = la primera que haya.
POWERBI_VISUAL=REPORTE

# Solo se usa como respaldo si POWERBI_URL_INFORME esta vacio: la navegacion
# por la UI depende del idioma de la cuenta.
POWERBI_TERMINO_BUSQUEDA=validacion

# false = abre el navegador con ventana. Si la cuenta exige MFA hay que
# ejecutar visible al menos una vez, con POWERBI_PERFIL_NAVEGADOR puesto,
# para que la sesion quede guardada y las corridas diarias no la pidan.
POWERBI_HEADLESS=true

# Idioma que se fuerza en el navegador. NO cambiar sin revisar los selectores:
# todos son en espanol, y algunos test-ids incorporan la etiqueta traducida
# (p. ej. 'pbimenu-item.Exportar datos'). Sin fijarlo, Chromium headless pide
# la UI en ingles y la exportacion falla.
POWERBI_IDIOMA=es-CO

# Argumentos de compatibilidad con escritorio remoto (--disable-gpu y compania).
# Poner en true si alguna pagina sale en blanco al correr por RDP.
# OJO: incluye --no-sandbox, que desactiva el sandbox de Chrome. Por eso el
# valor por defecto es false. Comprobado el 21/08/2026: SINU cargaba bien SIN
# estos argumentos, asi que no activarlo "por si acaso".
# Canal del navegador: 'chrome' abre el Chrome instalado; 'chromium' el
# empaquetado con Playwright. Tiene que ser el MISMO en la automatizacion y en
# la grabacion, porque comparten POWERBI_PERFIL_NAVEGADOR: mezclar versiones
# sobre un perfil lo degrada y el navegador muere al arrancar. Si se cambia,
# empezar con un perfil nuevo.
NAVEGADOR_CANAL=chrome

NAVEGADOR_COMPAT_RDP=false

# Que perfil de Chrome abre la automatizacion:
#   chrome    -> el PERSONAL (contrasenas, cookies y favoritos ya guardados).
#                EXIGE CHROME CERRADO: bloquea la carpeta de su perfil.
#   proyecto  -> el dedicado de POWERBI_PERFIL_NAVEGADOR (autenticarse una vez).
#   <ruta>    -> cualquier otra carpeta de perfil.
# Comprobarlo: python scripts\probar_perfil.py
NAVEGADOR_PERFIL=chrome

# Cual de los perfiles dentro de 'User Data' ('Default', 'Profile 1'...).
# Solo aplica con NAVEGADOR_PERFIL=chrome.
NAVEGADOR_PERFIL_DIRECTORIO=Default

# Perfil dedicado (fuera del repo: guarda cookies de sesion).
# Solo se usa con NAVEGADOR_PERFIL=proyecto.
# Ejemplo: C:\Users\<usuario>\.playwright-perfil-powerbi
POWERBI_PERFIL_NAVEGADOR=

# =====================================================================
# SINU  (Etapas 3 y 4 - RPA con Playwright, sin API publica)
# =====================================================================
# La barra final importa: sin ella Tomcat puede responder 404. El codigo la
# fuerza igualmente, asi que da lo mismo como se escriba aqui.
SINU_URL=https://sigwt.cun.edu.co/sgacampus/

# Credenciales del Sistema academico. Con ellas, la etapa 3 y la grabacion
# entran solas: rellenan el formulario, marcan "No cerrar sesion" y la sesion
# queda guardada en POWERBI_PERFIL_NAVEGADOR.
# Ventaja de que entre el codigo y no la persona: al grabar con codegen, la
# contrasena NO acaba escrita en el script generado.
SINU_USUARIO=
SINU_PASSWORD=

# =====================================================================
# Google Drive  (Etapas 2 y 5 - por NAVEGADOR, no por API)
# La organizacion no concede acceso a Google Cloud Console, asi que no hay
# client_secret.json ni token.json: Drive se maneja con RPA sobre su UI web,
# reutilizando POWERBI_PERFIL_NAVEGADOR. La sesion de Google vive en ese
# perfil; si caduca, ejecutar la etapa 2 una vez con --visible.
# =====================================================================
GOOGLE_CARPETA_RAIZ=REPORTES 2026

# Id de la carpeta raiz, tal como aparece en su URL de Drive:
# https://drive.google.com/drive/folders/<ID>
GOOGLE_CARPETA_RAIZ_ID=

# =====================================================================
# Comportamiento
# =====================================================================
# MODO_SIMULACION=true  ->  jamas se ejecuta "Vincular grupos matriculados".
#
# La PLANTILLA se queda en true a proposito: una copia recien hecha no debe
# poder escribir en SINU sin que alguien lo decida. No es el valor de esta
# maquina -- ahi se puso en false el 01/09/2026, cuando la etapa 4 se ejecuto
# de verdad y quedo verificada end-to-end (12 estudiantes, 12 ciclos cerrados).
#
# Recordar que este NO es el unico cerrojo: la etapa 4 exige tambien
# --ejecutar-de-verdad y --periodo en la linea de comandos.
MODO_SIMULACION=true

# true = de un duplicado exacto se procesa solo la primera aparicion
DEDUPLICAR_EXACTOS=true

TIMEOUT_OPERACION_SEG=30
REINTENTOS_LOGIN=1

# Plazo para lo que renderiza el servidor (SSO, visual del informe).
TIMEOUT_RENDER_SEG=120

# Plazo de la exportacion en si. Con ~1300 filas el .xlsx tarda en generarse.
TIMEOUT_DESCARGA_SEG=300
